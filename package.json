{
  "name": "semantic-state-runtime-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p packages/core/tsconfig.build.json && tsc -p packages/runtime/tsconfig.build.json",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/runtime/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
