{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/connector-manifest-0.1.schema.json",
  "title": "Semantic Connector Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "capabilities", "entities"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "observe", "subscribe", "revisions", "idempotency"],
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "observe": { "type": "boolean" },
        "subscribe": { "type": "boolean" },
        "revisions": { "enum": ["none", "opaque", "monotonic"] },
        "idempotency": { "enum": ["none", "keyed"] }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalType", "externalType", "fields"],
        "properties": {
          "canonicalType": { "type": "string", "minLength": 1 },
          "externalType": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonical", "external", "access"],
              "properties": {
                "canonical": { "type": "string", "minLength": 1 },
                "external": { "type": "string", "minLength": 1 },
                "access": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["read", "write"] }
                },
                "authorityHint": {
                  "enum": ["primary", "secondary", "replica", "observation"]
                }
              }
            }
          }
        }
      }
    }
  }
}
